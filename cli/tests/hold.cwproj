<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{A2E4F6B8-1C3D-4E5F-8A9B-2C3D4E5F6A73}</ProjectGuid>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">Win32</Platform>
    <OutputType>Exe</OutputType>
    <AssemblyName>hold</AssemblyName>
    <OutputName>hold</OutputName>
    <Model>Lib</Model>
    <stack_size>65536</stack_size>
    <CopyCore>False</CopyCore>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>False</DebugSymbols><DebugType>None</DebugType><vid>off</vid>
    <check_stack>False</check_stack><check_index>False</check_index>
  </PropertyGroup>
  <ItemGroup>
    <FileDriver Include="TOPSPEED" />
    <FileDriver Include="DOS" />
    <Compile Include="hold.clw" />
  </ItemGroup>
  <Import Project="$(ClarionBinPath)\SoftVelocity.Build.Clarion.targets" />
</Project>
